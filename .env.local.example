# =============================================================
# Vzorové proměnné prostředí pro Klubovna Čtyřkoly
# -------------------------------------------------------------
# Zkopírujte tento soubor jako .env.local a vyplňte skutečné
# hodnoty. .env.local se nikdy nenahrává do gitu ani na Vercel
# napřímo - na Vercelu se tyto hodnoty zadávají v nastavení
# projektu (Project Settings → Environment Variables).
# =============================================================

# --- Supabase ---
# Najdete v Supabase: Project Settings → API
# SUPABASE_URL = "Project URL"
# SUPABASE_SERVICE_ROLE_KEY = "service_role" klíč (NIKDY "anon" klíč!)
# Pozor: service_role klíč má plný přístup k databázi a obchází
# zabezpečení (RLS). Nikdy ho nedávejte do kódu, který běží
# v prohlížeči, a nikdy ho nezveřejňujte (např. v NEXT_PUBLIC_ proměnné).
SUPABASE_URL=https://vase-projektove-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=vlozte_sem_service_role_klic

# --- Resend (odesílání e-mailů) ---
# Vytvořte účet na resend.com, vygenerujte API klíč
# (Dashboard → API Keys).
RESEND_API_KEY=re_vlozte_sem_svuj_klic

# Adresa, ze které budou e-maily odesílány. Pro produkci je
# potřeba mít v Resend ověřenou vlastní doménu (Dashboard → Domains).
# Pro rychlé testování lze použít "onboarding@resend.dev",
# ale ten doručuje jen na e-mail vlastníka Resend účtu.
EMAIL_FROM=rezervace@vase-obec.cz

# Kam chodí oznámení o nových rezervacích administrátorovi.
ADMIN_NOTIFICATION_EMAIL=spravce@vase-obec.cz

# --- Administrace ---
# Heslo pro přihlášení do administrace. Zvolte silné heslo.
ADMIN_PASSWORD=zvolte_si_silne_heslo

# Tajný klíč pro podepisování přihlašovací session. Vygenerujte
# dlouhý náhodný řetězec, např. příkazem:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=vlozte_sem_nahodny_dlouhy_retezec
